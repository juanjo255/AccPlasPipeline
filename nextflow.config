manifest {
    name            = 'accessory_plasmids'
    description     = 'Detection of accessory plasmids in Sinorhizobium meliloti genome assemblies'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0'
}

params {
    // Input / output
    input             = null      // CSV samplesheet: sample,assembly,assembly_info
    outdir            = 'results'
    publish_dir_mode  = 'copy'

    // Step 1: contig length filter
    max_contig_len    = 1000000   // maximum length (bp) of each contig to keep
    add_sample_suffix = true      // rename contig IDs to <contig>_<sample>

    // Step 2: geNomad plasmid classification
    genomad_db        = null      // path to geNomad database directory (publication: DB v1.9)

    // Step 3: related PLSDB plasmids (publication: PLSDB 2024_05_31_v2)
    plsdb_fasta       = null      // PLSDB sequences FASTA
    plsdb_nuccore     = null      // PLSDB nuccore.csv (record metadata)
    plsdb_typing      = null      // PLSDB typing.csv (MOB-typer results)
    plsdb_keyword     = 'meliloti' // keyword in MOB-typer nearest neighbour or description
    plsdb_mash        = false     // also add PLSDB mash hits to the filtered contigs
    plsdb_sketch      = null      // PLSDB Mash sketch (needed with --plsdb_mash)
    mash_max_dist     = 0.1       // mash dist -d
    mash_max_pvalue   = 0.1       // mash dist -v

    // Step 4: MobMess de-replication
    mobmess_max_len   = 1000000   // keep clusters whose members are all shorter than this (bp)

    // Step 6: plasmid markers
    bakta_db          = null      // Bakta database directory (publication: v6.0 full)
    mobsuite_db       = null      // MOB-suite database directory
    feature_exclude   = null      // optional IDs to exclude after manual curation
    flag_max_len      = 50000     // review flag: plasmids shorter than this (bp) ...
    flag_min_rel_cov  = 0.5       // ... with depth below this fraction of the chromosome depth

    // Step 7: RepABC operons and replicon groups
    repabc_wrap_circular = false  // let RepABC windows wrap around circular plasmids (publication: off)
    repa_references   = "${projectDir}/assets/Rh_repA_replicons.fasta" // reference RepA (Cavassim et al. 2020)
    replicon_names    = null      // optional sequence <tab> group, to keep earlier group names

    // Step 10: functional annotation of the accessory plasmids
    skip_annotation      = false
    tasmania_hmms        = null    // directory with TASmania *.hmm3 files
    ta_evalue            = 1e-3    // TA genes counted below this E-value (per protein, Z = 1, as TASer)
    ta_report_evalue     = 1e-2    // TA genes reported (and used for operon structure) below this E-value
    defensefinder_models = null    // macsyfinder models dir containing defense-finder-models (publication: 3.1.0)
    antismash_db         = null    // antiSMASH databases directory (download-antismash-databases)
    dbcan_db             = null    // dbCAN database directory (run_dbcan database)
    dbcan_methods        = 'diamond,hmm,dbCANsub' // publication effectively: hmm,dbCANsub (DIAMOND returned nothing)
    cazyme_min_tools     = 2       // keep CAZymes found by at least this many dbCAN tools
    signalp_module       = null    // e.g. 'signalp/6.0-fast' (licensed; environment module)
    signalp_model_dir    = null    // SignalP 6 model directory

    // Step 11: replicon tags, copy number, k-mer composition (skipped without a reference genome)
    reference_genome     = null    // reference genome FASTA (publication: S. meliloti GCF_037023865.1)
    reference_tags       = "${projectDir}/assets/reference_replicon_tags.tsv" // reference replicon <tab> tag
    tag_min_ref_cov      = 30      // a tag needs >= this % coverage of the replicon (0 = publication rule)

    // Step 13: gene content
    eggnog_db            = null    // eggNOG-mapper data directory (publication: eggNOG 5.0.2); enables the COG analysis
    cog_min_cluster      = 3       // COG enrichment: clusters with > N plasmids; heatmap: >= N
    gene_sharing         = false   // Panaroo on genomes (samplesheet gff) + plasmids; needs --reference_genome
    signalp4_module      = null    // SignalP 4.1 environment module (Stowers: 'spada/1.0'); enables signal peptide families
    signalp_top          = 15      // signal peptide families shown in the bar plot (Fig. 9D)

    // Step 14: cointegrates
    partner_min_len         = 20000  // plasmid partner: backbone >= this length with a Rep gene in the covered region
    cointegrate_min_part    = 0.2    // cointegrate: each of two plasmid partners covers >= this fraction
    cointegrate_max_overlap = 0.2    // ... overlapping by <= this fraction of the smaller covered length
    cointegrate_min_union   = 0.8    // ... and together covering >= this fraction
    segment_min_bp          = 5000   // extra segments (outside the plasmid partners) reported from this length
    junction_window         = 5000   // genes within this distance of a junction / segment end are reported
}

process {
    cpus   = 1
    memory = 2.GB
    time   = 1.h

    withLabel: 'process_single' {
        cpus   = 1
        memory = 2.GB
        time   = 1.h
    }

    withLabel: 'process_low' {
        cpus   = 2
        memory = 8.GB
        time   = 2.h
    }

    withLabel: 'process_medium' {
        cpus   = 8
        memory = 32.GB
        time   = 4.h
    }

    withLabel: 'process_panaroo' {
        cpus   = 32
        memory = 100.GB
        time   = 72.h
    }

    withLabel: 'process_high' {
        cpus   = 32
        memory = 100.GB
        time   = 72.h
    }

    withName: 'SEQKIT_FILTER_CONTIGS' {
        publishDir = [
            path: { "${params.outdir}/01_contig_length_filter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'GENOMAD_ENDTOEND' {
        publishDir = [
            path: { "${params.outdir}/02_genomad/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'MASH_DIST_PLSDB|PLSDB_SELECT|PLSDB_EXTRACT' {
        publishDir = [
            path: { "${params.outdir}/03_plsdb_related" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'FLYE_CIRCULARITY|MOBMESS_SYSTEMS|MOBMESS_FILTER_CLUSTERS' {
        publishDir = [
            path: { "${params.outdir}/04_mobmess" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'MOBMESS_NETWORK' {
        publishDir = [
            path: { "${params.outdir}/05_network" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'BAKTA' {
        publishDir = [
            path: { "${params.outdir}/06_plasmid_features/bakta" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'MOB_TYPER' {
        publishDir = [
            path: { "${params.outdir}/06_plasmid_features/mob_typer" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'REPABC_OPERONS' {
        ext.args   = { params.repabc_wrap_circular ? '--wrap-circular' : '' }
        publishDir = [
            path: { "${params.outdir}/07_replicon_groups" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'REPLICON_GROUPS' {
        publishDir = [
            path: { "${params.outdir}/07_replicon_groups" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'MOBMESS_SYSTEMS_FINAL' {
        ext.prefix = 'mobmess_final'
        publishDir = [
            path: { "${params.outdir}/08_mobmess_final" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'PLOT_PLASMID_FEATURES' {
        publishDir = [
            path: { "${params.outdir}/09_summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'BAKTA_PLASMID' {
        cpus   = 4
        memory = 16.GB
        publishDir = [
            path: { "${params.outdir}/10_annotation/bakta/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'MERGE_ANNOTATIONS|TASMANIA|ANNOTATION_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/10_annotation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'DEFENSEFINDER' {
        publishDir = [
            path: { "${params.outdir}/10_annotation/defensefinder" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'ANTISMASH|DBCAN|SIGNALP' {
        publishDir = [
            path: { "${params.outdir}/10_annotation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'EGGNOG_MAPPER|COG_ANALYSIS|PANAROO|GENE_SHARING|PANAROO_PLASMIDS|SIGNALP4|SIGNAL_PEPTIDES' {
        publishDir = [
            path: { "${params.outdir}/13_gene_content/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'COINTEGRATES' {
        publishDir = [
            path: { "${params.outdir}/14_cointegrates" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'SKANI_ANI' {
        publishDir = [
            path: { "${params.outdir}/12_plasmid_ani" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'TAG_REPLICONS' {
        publishDir = [
            path: { "${params.outdir}/11_replicons/tags" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.tsv') ? filename : null }
        ]
    }

    withName: 'COPY_NUMBER' {
        publishDir = [
            path: { "${params.outdir}/11_replicons/copy_number" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'KMER_COMPOSITION' {
        publishDir = [
            path: { "${params.outdir}/11_replicons/kmer" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'PLASMID_FEATURES' {
        publishDir = [
            path: { "${params.outdir}/06_plasmid_features" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}

profiles {
    // Software is provided only through conda (one environment per module)
    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda']
        // geNomad (TensorFlow) and MobMess (pip from GitHub) take a while to build
        conda.createTimeout = '1 h'
    }
    slurm {
        process.executor       = 'slurm'
        executor.queueSize     = 100
        executor.submitRateLimit = '10 sec'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
